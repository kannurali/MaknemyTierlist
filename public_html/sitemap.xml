<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://maknemy.com/</loc>
    <changefreq>daily</changefreq>
    <priority>1.0</priority>
  </url>
  <!-- Тирлист переехал сюда с корня: корень теперь занят главной. -->
  <url>
    <loc>https://maknemy.com/tierlist</loc>
    <changefreq>daily</changefreq>
    <priority>0.9</priority>
  </url>
  <!-- Калькулятор — инструмент поверх тирлиста, а не отдельный раздел
       контента: разметка статична, цены он тянет у клиента через
       /api/tierlist.php. Отсюда weekly и приоритет ниже тирлиста/ленты. -->
  <url>
    <loc>https://maknemy.com/calculator</loc>
    <changefreq>weekly</changefreq>
    <priority>0.7</priority>
  </url>
  <!-- Лента наполнилась (29 постов на 2026-08-31), поэтому /news объявлен
       здесь наравне с остальными разделами. До этого блок был закомментирован
       намеренно: sitemap говорит поисковику «страница важная, индексируй», и
       на пустую ленту он пришёл бы за тонким содержимым.

       Сами посты (/news/<id>) здесь НЕ перечисляются: файл статический, а их
       список меняется с каждой публикацией — он разъехался бы с лентой в тот
       же день. Краулер доходит до постов по ссылкам с /news, а канонический
       адрес каждого поста ставит сама news.php. -->
  <url>
    <loc>https://maknemy.com/news</loc>
    <changefreq>daily</changefreq>
    <priority>0.8</priority>
  </url>
</urlset>
