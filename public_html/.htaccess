# Force HTTPS
RewriteEngine On

# --------------------------- Канонический хост ---------------------------
# Основной домен — maknemy.com. Сайт переехал на него с maknemytierlist.site
# (тот оплачен до 2027-07-28 и остаётся живым: пока он отвечает 301, он
# передаёт новому домену накопленный вес в поиске). Любой другой хост —
# старый домен, www, технический адрес хостинга — отдаёт 301 на канонический.
#
# Правило стоит ДО HTTPS-редиректа ниже намеренно. Если поставить его после,
# запрос http://maknemytierlist.site/x прыгал бы дважды: сначала на https
# того же старого хоста, и только потом на новый домен. Здесь схема и хост
# меняются за один 301.
#
# .well-known исключён по той же причине, что и у HTTPS-редиректа ниже, но
# последствия тут другие и хуже: без этого условия ACME-проверка СТАРОГО
# домена уезжала бы редиректом на новый, сертификат для старого перестал бы
# продлеваться, и примерно через 90 дней он начал бы отдавать ошибку TLS
# вместо редиректа — то есть ровно тот трафик, ради которого старый домен
# держат, упирался бы в предупреждение браузера, а не переходил на новый
# адрес.
#
# Хост сравнивается без учёта регистра и не включает www: %{HTTP_HOST}
# приходит из заголовка запроса как есть, и "WWW.Maknemy.com" — валидный
# способ попросить ту же страницу, который должен схлопнуться в один
# канонический адрес, а не остаться вторым рабочим.
#
# Необязательный ":порт" в шаблоне — страховка от цикла, а не педантизм:
# если TLS терминирует прокси и до Apache доходит Host вида
# "maknemy.com:443", шаблон без порта не совпал бы, и КАЖДЫЙ запрос к
# каноническому домену уезжал бы редиректом сам на себя — сайт лёг бы
# целиком с ERR_TOO_MANY_REDIRECTS.
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteCond %{HTTP_HOST} !^maknemy\.com(:[0-9]+)?$ [NC]
RewriteRule ^ https://maknemy.com%{REQUEST_URI} [L,R=301]

# Let ACME/AutoSSL validation through over plain HTTP. Without this the
# redirect below blocks .well-known, and the Let's Encrypt certificate fails
# to renew — the site would break roughly 90 days after issue.
RewriteCond %{REQUEST_URI} !^/\.well-known/

# %{HTTPS} is not set when TLS is terminated by a proxy in front of Apache
# (common on shared hosting); checking X-Forwarded-Proto as well avoids an
# endless redirect loop in that setup.
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# "/" отдаёт главную (home.php), а не тирлист: по макету это два разных
# раздела, и в шапке они стоят отдельными пунктами. Явная директива, а не
# дефолт хостинга: порядок в дефолтном DirectoryIndex шаред-хостинга —
# деталь конфигурации cPanel, которую не стоит подразумевать молча. Без неё
# Apache подхватил бы index.php и на "/" снова оказался бы тирлист.
DirectoryIndex home.php

# ------------------------------- Тирлист -------------------------------
# Тирлист переехал с "/" на /tierlist, потому что корень занят главной.
#
# Адрес намеренно без завершающего слэша — та же причина, что у /admin ниже
# и у /news выше: внутри index.php все пути документ-относительные
# ("css/base.css", "js/app.js", "assets/…"). На /tierlist база документа —
# корень, и они разрешаются как раньше; на /tierlist/ база стала бы
# "/tierlist/", и весь CSS с JS уехал бы в 404. Поэтому слэш снимается
# внешним 301, а не внутренним рероутом: иначе в адресной строке и в индексе
# поисковика остались бы два рабочих адреса с одним содержимым.
RewriteRule ^tierlist/$ /tierlist [L,R=301]

# Прежний прямой адрес файла. Без этого правила тирлист был бы доступен и на
# /tierlist, и на /index.php — снова дубль. Условие на REDIRECT_STATUS
# обязательно: без него внутренний рероут /tierlist → /index.php строкой
# ниже сам попал бы под это правило, и получился бы бесконечный редирект.
# У внутренних рероутов REDIRECT_STATUS уже выставлен, у запроса из браузера
# он пуст — по этому и различаем.
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteRule ^index\.php$ /tierlist [L,R=301]

RewriteRule ^tierlist$ /index.php [L]

# --------------------------- Калькулятор трейдов ---------------------------
# Тот же приём, что у /tierlist выше: внутри calculator.php все пути
# документ-относительные ("css/base.css", "js/calc.js", "assets/…"). На
# /calculator база документа — корень, и они разрешаются как есть; на
# /calculator/ база стала бы "/calculator/", и весь CSS с JS уехал бы в 404.
# Поэтому слэш снимается внешним 301, а не внутренним рероутом: иначе в
# адресной строке и в индексе поисковика остались бы два рабочих адреса с
# одним содержимым.
RewriteRule ^calculator/$ /calculator [L,R=301]

# Прямой адрес файла — 301 на канонический /calculator, та же защита от
# дубля, что у /index.php -> /tierlist выше. Условие на REDIRECT_STATUS
# обязательно: без него внутренний рероут /calculator → /calculator.php
# строкой ниже сам попал бы под это правило, и получился бы бесконечный
# редирект. У внутренних рероутов REDIRECT_STATUS уже выставлен, у запроса из
# браузера он пуст — по этому и различаем.
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteRule ^calculator\.php$ /calculator [L,R=301]

RewriteRule ^calculator$ /calculator.php [L]

# /news/ (со слэшем на конце) — 301 на канонический /news, а не на news.html.
# Без этого правила ниже (^news/?$) молча принимает и /news, и /news/ как один
# и тот же внутренний рероут на news.html — но это ВНУТРЕННИЙ рероут: адрес в
# адресной строке остаётся /news/, и document base у страницы становится
# "/news/". А в news.html все пути документ-относительные (css/base.css,
# js/news.js, api/news.php и т. д.), они резолвятся от base — и на /news всё
# работает, а на /news/ всё это превращается в 404: голый нестилизованный
# HTML без JS и без ленты.
#
# Правило стоит ПОСЛЕ HTTPS-редиректа (строки выше) и exemption для
# .well-known: оно не должно ни идти раньше их (тогда HTTP-запрос на /news/
# уехал бы на /news ещё по HTTP, а последующий HTTPS-редирект сделал бы
# второй прыжок вместо одного) и не должно попадать под них (правило не
# трогает .well-known — паттерн ^news/$ его не матчит в принципе). Стоит ДО
# внутреннего рероута ^news/?$ ниже, иначе тот успел бы обслужить /news/
# первым и до внешнего редиректа дело бы не дошло. Внешний (R=301), а не
# внутренний рероут — чтобы адрес в браузере и в индексе поисковика тоже стал
# каноническим: иначе на сайте существовали бы два разных URL с одинаковым
# содержимым.
RewriteRule ^news/$ /news [L,R=301]

# /news.html — прежний прямой адрес файла, который стал именем ленты после
# переезда на PHP (news.html -> news.php, см. public_html/news.php). Без этого
# правила по нему было бы два рабочих адреса с одинаковым содержимым
# (/news и /news.html) — та же самая ошибка, от которой правило выше защищает
# /news/. Правило стоит ДО внутреннего рероута ^news/?$ ниже по той же причине,
# что и правило для /news/ выше: иначе тот рероут (который тоже матчит слэш в
# конце, но не литеральный ".html") успел бы обслужить что-то раньше внешнего
# редиректа — здесь это не пересекается, но порядок сохранён для единообразия
# и на случай, если паттерны когда-нибудь пересекутся.
RewriteRule ^news\.html$ /news [L,R=301]

# Чистый адрес для ленты. Отдельного PHP-роутинга у сайта нет, а /news.html в
# ссылках выглядит как файл, а не раздел.
RewriteRule ^news/?$ /news.php [L]

# /news/<id> — свой адрес у конкретного поста (задача про постоянные ссылки):
# та же news.php, но с og:*/canonical этого конкретного поста, а не самого
# свежего — см. news_parse_post_id()/news_post_by_id() в public_html/news.php.
#
# Тот же трюк с document-relative путями внутри news.php («css/base.css»,
# «js/news.js»), что правило выше уже решает для /news/ → /news: адрес на
# глубине 2 (news/<id>) сдвинул бы базу документа в "/news/", и все такие пути
# уехали бы в несуществующие /news/css/…, /news/js/… . Здесь это НЕ чинится
# точечным переписыванием путей под одну конкретную глубину (как делает
# admin-news.php для /admin/news — тот приём привязан к глубине 1 и не
# годится для id произвольной длины): вместо этого news.php сам ставит
# <base href="/"> в <head>, и относительные пути резолвятся от корня при
# любой глубине запроса — читать этот трюк там, а не здесь.
#
# Сначала — 301 на канонический вид без завершающего слэша (та же причина,
# что и у /news/ → /news выше: без этого /news/42 и /news/42/ были бы двумя
# рабочими адресами с одинаковым содержимым).
RewriteRule ^news/([0-9]+)/$ /news/$1 [L,R=301]

# И только потом — внутренний рероут на канонический вид. [0-9]+ — строго
# цифры: id приходит из адресной строки посетителя, и мусор здесь должен
# просто не смэтчиться (запрос упадёт дальше по правилам/в 404 Apache), а не
# быть молча приведён к какому-то id — тот же принцип строгой валидации, что
# у og_parse_version()/read_row_id() в api/_bootstrap.php и api/lib/og.php.
RewriteRule ^news/([0-9]+)$ /news.php?id=$1 [L]

# ---------------------------- Панель управления ----------------------------
# Адреса без .php. Завершающий слэш у /admin снимается редиректом намеренно:
# страница отдаёт разметку index.html как есть, а относительные пути внутри
# неё и внутри app.js ("assets/dot-green.png", "js/html2canvas.min.js")
# считаются от адреса документа. На /admin/ они уехали бы в /admin/assets/ и
# вернули бы 404; на /admin разрешаются от корня и работают без правок.
RewriteRule ^admin/$        /admin              [R=301,L]
RewriteRule ^admin$         /admin.php          [L]
RewriteRule ^admin/news/?$  /admin-news.php     [L]
RewriteRule ^admin/promo/?$ /admin-promo.php    [L]
RewriteRule ^admin/logout/?$ /admin-logout.php  [L]

# Прежний адрес панели рекламы. Правило стоит до отдачи файлов, поэтому
# работает и на боевом сервере, где старый promo-admin.html ещё лежит:
# деплой копирует поверх (cp -R) и ничего не удаляет.
RewriteRule ^promo-admin\.html$ /admin/promo [R=301,L]

# Deny access to sensitive files
<FilesMatch "\.(sql|md|mjs)$">
  Require all denied
</FilesMatch>

# No directory listings: /api/ and /images/ were serving autoindex pages,
# handing visitors a free inventory of every file.
Options -Indexes

# Baseline security headers. `always` so they ride on error responses too.
# No CSP on purpose: html2canvas (PNG export) and inline-style tweaks would
# need auditing first — a hasty policy would break the export button.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Site is HTTPS-only (redirect above); 180 days, no preload — reversible.
  Header always set Strict-Transport-Security "max-age=15552000"
</IfModule>

# index.html carries the ?v= numbers for app.js and styles.css, so a stale
# copy of it pins visitors to stale code no matter how the versions are
# bumped. Apache sends no Cache-Control for .html, which leaves browsers to
# invent their own freshness from Last-Modified — Safari in particular then
# served an old page for hours after a deploy. Always revalidate; the file is
# 18 KB and the request is a 304 whenever nothing changed.
#
# index.html/news.html не существуют больше (index.php/news.php теперь сами
# считают og:image/title/description из живых данных, см. public_html/
# index.php и public_html/news.php) — этому FilesMatch больше нечего ловить,
# он оставлен как безвредный no-op на случай, если .html-файл когда-нибудь
# вернётся, а не удалён. Сама защита НЕ потеряна — она переехала в сами эти
# два PHP-файла, которые зовут header('Cache-Control: no-cache,
# must-revalidate') напрямую. Просто заменить паттерн на
# <FilesMatch "^(index|news)\.php$"> здесь было нельзя: FilesMatch матчит по
# имени файла, а не по пути, и этот паттерн зацепил бы заодно
# public_html/api/news.php (эндпоинт ленты новостей — не тот файл, но то же
# имя) и молча переписал бы его собственный, намеренный Cache-Control
# (см. api/news.php) этим значением.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# Site assets (assets/*) are hand-named and mostly carry no ?v= cache-buster,
# so they must NOT be immutable — replacing one in place has to take effect.
# Cache briefly and always revalidate. The content-hashed uploads under
# images/ get the immutable header from images/.htaccess instead.
<IfModule mod_headers.c>
  <FilesMatch "\.(webp|png|jpg|jpeg|ico)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
</IfModule>
